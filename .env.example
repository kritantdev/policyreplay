# Copy to /etc/policyreplay.env on the VM (chmod 600, owned by the service user). NEVER commit the real file.
VULTR_INFERENCE_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
PR_TEXT_MODEL=minimax-m3.1-flash
# PR_JSON_MODE=1            # only if the model endpoint supports response_format
# PR_RUN_MODE=docker        # docker = hardened sandbox (default: local, development only)
# PR_DAILY_MODEL_CALLS=100  # daily cap on model calls (default 100); the live value is set in deploy/policyreplay.service
# PR_TRUST_PROXY=1          # when behind a reverse proxy (per-IP rate limits use X-Forwarded-For)
# PR_DEBUG=1                # print raw model output to stderr (never prints the key)
# PR_NO_SANDBOX=1           # local mode only: launch Chromium with --no-sandbox when running as root (never in docker mode)
