# systemd unit for the PolicyReplay orchestrator (API + dashboard).
# Install:  sudo cp deploy/policyreplay.service /etc/systemd/system/policyreplay.service
#           sudo systemctl daemon-reload && sudo systemctl restart policyreplay
# Secrets (VULTR_INFERENCE_KEY, PR_TEXT_MODEL) live ONLY in /etc/policyreplay.env, never in this file or in git.
[Unit]
Description=PolicyReplay orchestrator
After=network-online.target docker.service
Requires=docker.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/policyreplay
EnvironmentFile=/etc/policyreplay.env
Environment=PR_RUN_MODE=docker
Environment=PR_TRUST_PROXY=1
# Daily cap on live model calls (one analysis uses 2). At the cap the app does not fail: it serves labeled
# "replayed model output". Edit this ONE line to change the cap; do not also set it in /etc/policyreplay.env.
Environment=PR_DAILY_MODEL_CALLS=150
# Bound to localhost on purpose: only the reverse proxy (Caddy) may reach the API.
ExecStart=/home/deploy/policyreplay/.venv/bin/uvicorn orchestrator.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
