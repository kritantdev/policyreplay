{
  "rules": [
    {
      "rule_id": "P-01",
      "source_clause": "Refunds above INR 10,000 require manager approval.",
      "actor": "support",
      "action": "issue_refund",
      "params": {
        "threshold": 10000
      },
      "invariant_type": "approval_required_over_threshold"
    },
    {
      "rule_id": "P-05",
      "source_clause": "Customers cannot access another customer's order.",
      "actor": "customer",
      "action": "view_order",
      "params": {},
      "invariant_type": "owner_only_access"
    },
    {
      "rule_id": "P-02",
      "source_clause": "Only administrators can modify user roles.",
      "actor": "support",
      "action": "modify_user_role",
      "params": {},
      "invariant_type": "role_change_admin_only"
    },
    {
      "rule_id": "P-03",
      "source_clause": "Shipped orders cannot be cancelled.",
      "actor": "customer",
      "action": "cancel_order",
      "params": {},
      "invariant_type": "no_cancel_after_ship"
    },
    {
      "rule_id": "P-04",
      "source_clause": "Discounts cannot exceed 30%.",
      "actor": "support",
      "action": "apply_discount",
      "params": {
        "max_percent": 30
      },
      "invariant_type": "max_discount_pct"
    }
  ],
  "unsupported_clauses": []
}
