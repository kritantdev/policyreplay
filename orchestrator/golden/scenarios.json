        },
        {
          "action": "expect",
          "testid": "order-total",
          "text": "20000"
        },
        {
          "action": "fill",
          "testid": "refund-amount",
          "value": "15000"
        },
        {
          "action": "click",
          "testid": "refund-submit"
        }
      ],
      "expected_outcome": "blocked",
      "invariant_type": "approval_required_over_threshold"
    },
